# Environment variables for local development
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# SAP SuccessFactors
SF_API_URL=https://apim.nordvik.se/sap/successfactors/v1
SF_TOKEN_URL=https://apim.nordvik.se/sap/oauth/token
SF_CLIENT_ID=your-sf-client-id
SF_CLIENT_SECRET=your-sf-client-secret

# Azure Active Directory / Entra ID
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_CLIENT_ID=your-azure-app-client-id
AZURE_CLIENT_SECRET=your-azure-app-client-secret

# SMTP / Email
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=orchestrate@nordvik.se
SMTP_PASSWORD=your-smtp-app-password

# Microsoft Teams (optional)
TEAMS_WEBHOOK_URL=https://nordvik.webhook.office.com/webhookb2/your-webhook-id

# watsonx Orchestrate
WX_ORCHESTRATE_INSTANCE_URL=https://dl.watson-orchestrate.ibm.com/instances/your-instance-id
